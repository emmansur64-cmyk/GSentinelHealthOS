        max-file: "3"
    depends_on:
      db:
        condition: service_healthy
      redis-master:
        condition: service_healthy
      redis-sentinel-1:
        condition: service_healthy
    environment:
      DATABASE_URL: ${DATABASE_URL:-postgresql+psycopg://${DB_USER}:${DB_PASSWORD}@db:5432/gsentinel}
      REDIS_URL: ${REDIS_URL:-redis://:${REDIS_PASSWORD}@redis-master:6379}
      REDIS_SENTINEL_MASTER: ${REDIS_SENTINEL_MASTER:-mymaster}
      REDIS_SENTINELS: ${REDIS_SENTINELS:-redis-sentinel-1:26379,redis-sentinel-2:26379,redis-sentinel-3:26379}
      REDIS_QUEUE_PREFIX: ${REDIS_QUEUE_PREFIX:-queue:}
      REDIS_STATE_PREFIX: ${REDIS_STATE_PREFIX:-state:}
      REDIS_CACHE_PREFIX: ${REDIS_CACHE_PREFIX:-cache:}
      JWT_SECRET: ${JWT_SECRET}
      GATEWAY_API_KEY: ${GATEWAY_API_KEY}
      BRAIN_API_KEY: ${BRAIN_API_KEY}
      OUTBOX_PROCESS_LIMIT: ${OUTBOX_PROCESS_LIMIT:-200}
