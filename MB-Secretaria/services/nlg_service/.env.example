# nlg-service production environment example
# Copy values into your deployment secret manager or runtime env vars.

# Core service
CEREBRO_API_KEY=replace_with_real_api_key

# Groq integration
GROQ_API_KEY=replace_with_real_groq_api_key
NLG_GROQ_ENABLED=true
NLG_PROMPTS_DIR=metabrain/prompts
NLG_GROQ_MODEL=llama3-70b-8192
NLG_GROQ_TEMPERATURE=0.4
NLG_GROQ_MAX_TOKENS=700
NLG_GROQ_ENABLE_REWRITER=true

# Internal diagnostics endpoint protection
# If false, /internal/diagnostics/llm-status returns 404.
NLG_INTERNAL_DIAGNOSTICS_ENABLED=false
# Optional shared secret for X-Internal-Token header.
NLG_INTERNAL_DIAGNOSTICS_TOKEN=replace_with_internal_token
