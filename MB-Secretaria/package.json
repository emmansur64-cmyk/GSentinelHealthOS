{
  "name": "mb-secretaria",
  "version": "0.1.0",
  "private": true,
  "description": "Modulo administrativo de Secretaria Medica",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --config jest.config.ts --watch",
    "test:cov": "jest --config jest.config.ts --coverage",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^10.4.2",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.2",
    "@nestjs/platform-express": "^10.4.2",
    "dotenv": "^17.4.1",
    "exceljs": "^4.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.7.4",
    "eslint": "^9.12.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  },
  "overrides": {
    "protobufjs": "7.5.8",
    "@protobufjs/utf8": "1.1.1",
    "lodash": "4.18.1",
    "@nestjs/platform-express": {
      "multer": "2.1.1"
    },
    "@angular-devkit/core": {
      "picomatch": "4.0.4"
    },
    "@nestjs/cli": {
      "glob": "10.5.0"
    },
    "external-editor": {
      "tmp": "0.2.5"
    }
  }
}
