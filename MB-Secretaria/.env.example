NODE_ENV=development
PORT=3000
AGENDA_API_BASE_URL=
AGENDA_API_DRY_RUN_HTTP_ENABLED=false
AGENDA_API_DRY_RUN_PATH=/admin/schedule-import/dry-run
AGENDA_API_TIMEOUT_MS=3000
AGENDA_API_DRY_RUN=true
AGENDA_API_ALLOWED_HOSTS=localhost,127.0.0.1
AGENDA_API_AUTH_HEADER=x-internal-api-key
AGENDA_API_AUTH_TOKEN=
MB_SECRETARIA_ADMIN_API_KEY=
MB_SECRETARIA_ALLOWED_ROLES=secretary,admin
MB_SECRETARIA_REQUIRED_SCOPE=schedule:import:preview
MB_SECRETARIA_AUDIT_ENABLED=true
MB_SECRETARIA_AUDIT_DIR=./audit
