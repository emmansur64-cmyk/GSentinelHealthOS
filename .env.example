# ============ DATABASE ============
DATABASE_URL=
DB_USER=sentinel
DB_PASSWORD=
# MODO LOCAL (compose): dejar DATABASE_URL vacio para usar fallback del compose
# MODO EXTERNO (managed/VM): definir DATABASE_URL completa en .env.prod
# Ejemplos validos:
# DATABASE_URL=sqlite:///./sentinel_health_local_sqlite.db
# DATABASE_URL=postgresql+psycopg://<usuario>:<password>@<host>:5432/<database>

# ============ REDIS ============
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@redis-master:6379
# MODO LOCAL (compose): REDIS_URL=redis://:${REDIS_PASSWORD}@redis-master:6379
# MODO EXTERNO (managed/VM): REDIS_URL=redis://:<password>@<host>:6379[/db]
# En Docker Compose usar:
# REDIS_URL=redis://:${REDIS_PASSWORD}@redis-master:6379
REDIS_SENTINEL_MASTER=mymaster
REDIS_SENTINELS=redis-sentinel-1:26379,redis-sentinel-2:26379,redis-sentinel-3:26379
REDIS_QUEUE_PREFIX=queue:
REDIS_STATE_PREFIX=state:
REDIS_CACHE_PREFIX=cache:
BOOKING_QUEUE_SHARDS=16
BOOKING_QUEUE_SHARDS_PROD=2
BOOKING_QUEUE_RESULT_TTL_SECONDS=86400
BOOKING_QUEUE_LOCK_TTL_MS=15000
# Worker CLI (scripts/run_booking_queue_worker.py)
BOOKING_WORKER_SHARD=0

# ============ API ============
API_HOST=0.0.0.0
API_PORT=8000

# ============ BRAIN ============
BRAIN_HOST=0.0.0.0
BRAIN_PORT=8001
# Modo de arranque: "http" (FastAPI + worker) | "worker" (solo Redis worker)
BRAIN_MODE=http
BRAIN_ALLOWED_ORIGINS=http://localhost:3000
API_BASE_URL=http://api:8000
BRAIN_STATE_TTL_SECONDS=86400

# ============ INTERNAL SERVICE AUTH ============
# Clave compartida entre brain y microservicios de IA (dejar vacío en desarrollo)
INTERNAL_SERVICES_KEY=

# ============ MICROSERVICIOS DE IA (Orquestación Central) ============
# dialogue-engine: gestión conversacional e intent detection
DIALOGUE_ENGINE_URL=http://localhost:8010
# inference-service: modelos ML de inferencia clínica
INFERENCE_SERVICE_URL=http://localhost:8011
# decision-service: motor de decisión clínica (triage, risk)
DECISION_SERVICE_URL=http://localhost:8012
# nlg-service: generación de lenguaje natural sin LLM
NLG_SERVICE_URL=http://localhost:8013
DIALOGUE_ENGINE_PORT=8010
INFERENCE_SERVICE_PORT=8011
DECISION_SERVICE_PORT=8012
NLG_SERVICE_PORT=8013

# ============ GATEWAY ============
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8002
GATEWAY_REDIS_SENTINELS=
GATEWAY_REDIS_SENTINEL_MASTER=
ENABLE_WHATSAPP_GATEWAY=true

# ============ BRAIN WORKER ============
ENABLE_BRAIN_REDIS_WORKER=true

# ============ WHATSAPP ============
WHATSAPP_VERIFY_TOKEN=WABIZ_VERIFY_2026_GSENTINEL
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PROCESSED_TTL_SECONDS=604800
WHATSAPP_OUTGOING_RATE_LIMIT=20
WHATSAPP_OUTGOING_RATE_WINDOW_SECONDS=60
WHATSAPP_DLQ_ALERT_THRESHOLD=50
WHATSAPP_DLQ_ALERT_WEBHOOK=
# Alias usado por docker-compose.yml para el monitor Redis
DLQ_ALERT_THRESHOLD=50

# ============ META EMBEDDED SIGNUP ============
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0
META_OAUTH_REDIRECT_URI=https://TU_DOMINIO/api/meta/embedded-signup/callback
META_EMBEDDED_SIGNUP_CONFIGURATION_ID=
# Usado por medical-agenda-saas para construir el boton "Conectar WhatsApp"
NEXT_PUBLIC_API_BASE_URL=https://TU_DOMINIO
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_OAUTH_REDIRECT_URI=https://TU_DOMINIO/api/meta/embedded-signup/callback
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIGURATION_ID=

# Clave obligatoria para cifrar tokens por clinica.
# Generar una Fernet key o una cadena larga aleatoria estable en producción.
SECRET_ENCRYPTION_KEY=

# ============ PHI COMPLIANCE ============
# El API valida estos valores en startup. Un valor ausente en ENV=production bloquea el arranque.

# Retención de datos PHI (días). HIPAA mínimo = 2190 (6 años). Argentina historia clínica = 3650 (10 años).
PHI_RETENTION_PATIENT_DAYS=3650
PHI_RETENTION_APPOINTMENT_DAYS=3650
PHI_RETENTION_ACCESS_LOG_DAYS=2190
PHI_RETENTION_CONSENT_DAYS=3650

# Habilitar audit log de acceso a datos PHI (true en producción obligatorio)
PHI_AUDIT_LOG_ENABLED=true

# Usar soft-delete en lugar de hard-delete (true preserva trazabilidad RGPD art.17)
PHI_SOFT_DELETE_ENABLED=true

# Versión de la política de privacidad vigente (se almacena en patient_consents)
PHI_POLICY_VERSION=1.0

# LLM: prohibido enviar PHI identificatoria a modelos externos (false = seguro)
# Solo cambiar a true si el proveedor firmó un BAA (HIPAA Business Associate Agreement)
LLM_PROVIDER_PHI_ALLOWED=false
AI_RUNTIME_PHI_ALLOWED=false

# ============ LOGGING ============
LOG_LEVEL=INFO
# LOG_FORMAT=json activa JSON estructurado en todos los servicios Python (recomendado producción).
# Promtail parsea los campos level/logger directamente del JSON.
# Usar LOG_FORMAT=text en desarrollo local para salida legible.
LOG_FORMAT=json

# ============ OBSERVABILIDAD (perfil Docker: --profile observability) ============
# Activar: docker compose --profile observability up -d
# Prometheus scraping API en :8000/api/metrics y Brain en :8001/metrics
PROMETHEUS_PORT=9090
# Grafana: http://localhost:3020  dashboard provisionado automáticamente
GRAFANA_PORT=3020
GRAFANA_ADMIN_USER=admin
# ⚠️ OBLIGATORIO EN PRODUCCIÓN — generar con: python -c "import secrets; print(secrets.token_hex(20))"
# Si se deja vacío, Grafana usará admin:admin por defecto (inseguro).
# NUNCA dejar vacío en ENV=production ni en servidores con red pública.
GRAFANA_ADMIN_PASSWORD=
GRAFANA_DOMAIN=localhost
# Loki: push desde Promtail, consultar desde Grafana
LOKI_PORT=3100
# Etiqueta job Prometheus en métricas del brain
OBSERVABILITY_JOB_LABEL=gsentinel-brain

# ============ ENVIRONMENT ============
ENV=development
# ENV=production

# ============ CORS ============
# Lista de orígenes permitidos (separados por comas, sin espacios)
# Ejemplo: http://localhost:3000,http://localhost:5173,https://app.example.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============ API CONFIGURATION ============
API_TITLE=GSentinelHealthOS API
API_VERSION=1.0.0
DEBUG=false

# ============ AUTHENTICATION (JWT) ============
# ⚠️ CAMBIAR EN PRODUCCIÓN - Generar: openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_ISSUER=gsentinel-api
JWT_AUDIENCE=gsentinel-clients
RATE_LIMIT_PER_MINUTE=200
# Alias usado por medical-agenda-saas en docker-compose.yml
JWT_EXPIRES_IN_HOURS=24

# ============ INTERNAL SERVICE SECURITY ============
GATEWAY_API_KEY=
BRAIN_API_KEY=
# Opcional: restringe por IP origen (separadas por coma)
GATEWAY_ALLOWED_IPS=172.20.0.5,172.20.0.6
BRAIN_ALLOWED_IPS=172.20.0.3

# Panel Super-Admin — sólo requerido cuando panel-admin está desplegado
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
PANEL_ADMIN_API_KEY=
# Opcional: IPs permitidas para el panel (vacío = sin restricción de IP)
PANEL_ADMIN_ALLOWED_IPS=

# ============ FRONTEND (medical-agenda-saas) ============
# Si API y Frontend comparten instancia PostgreSQL, usa hosts iguales y
# define database names explícitos en cada URL (pueden ser distintos).
# Ejemplo:
# DATABASE_URL=postgresql+psycopg://user:pass@db:5432/gsentinel
# FRONTEND_DATABASE_URL=postgresql://user:pass@db:5432/medical_agenda
FRONTEND_DATABASE_URL=
FRONTEND_PORT=3000
BRAIN_API_URL=http://brain:8001
BRAIN_TIMEOUT_MS=5000
WHATSAPP_AUTO_BOOT_WORKERS=false
DOCUMENT_AI_ENABLED=false
DOCUMENT_AI_PROVIDER=groq
DOCUMENT_AI_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY_CHAT=
GROQ_MODEL_CHAT=
# Recomendado para chat medico fluido con rigor: 0.4 - 0.6
DOCTOR_CHAT_GROQ_TEMPERATURE=0.5
GROQ_API_KEY_SECRETARIA=
GROQ_MODEL_SECRETARIA=

# ============ MEDICAL WEB RETRIEVAL (Doctor chat only) ============
MEDICAL_WEB_RETRIEVAL_ENABLED=true
MEDICAL_WEB_RETRIEVAL_MODE=allowlist
MEDICAL_WEB_RETRIEVAL_TIMEOUT_MS=8000
MEDICAL_WEB_RETRIEVAL_MAX_SOURCES=5

# ============ MEDICAL RUNTIME CONTEXT (Doctor chat only) ============
MEDICAL_RUNTIME_CONTEXT_ENABLED=true
MEDICAL_RUNTIME_CONTEXT_WEATHER_ENABLED=true
MEDICAL_RUNTIME_CONTEXT_ALERTS_ENABLED=true
MEDICAL_RUNTIME_CONTEXT_CACHE_TTL_SECONDS=900
MEDICAL_RUNTIME_CONTEXT_TIMEOUT_MS=5000
# Opcional DEV/LAB: usar region/coordenadas aproximadas de clinica, nunca GPS exacto ni direccion de paciente.
MEDICAL_RUNTIME_CONTEXT_TIMEZONE=America/Argentina/Buenos_Aires
MEDICAL_RUNTIME_CONTEXT_REGION=
MEDICAL_RUNTIME_CONTEXT_LATITUDE=
MEDICAL_RUNTIME_CONTEXT_LONGITUDE=

# ============ N8N WEBHOOKS ============
# Webhook para notificar confirmacion de cita (fire-and-forget)
N8N_WH_APPOINTMENT_CONFIRM=

# ============ GOOGLE CALENDAR (SERVICE ACCOUNT) ============
# Backend recomendado: usar service account, no OAuth interactivo.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_AUTH_MODE=service_account
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=UTC
# Elegir UNA opcion de credenciales:
# 1) JSON del service account serializado en una sola linea
GOOGLE_SERVICE_ACCOUNT_JSON=
# 2) JSON del service account codificado en base64
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# 3) Ruta al archivo JSON montado por el entorno/secret manager
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_OAUTH_CLIENT_SECRET_FILE=
GOOGLE_OAUTH_TOKEN_FILE=
GOOGLE_CALENDAR_WEBHOOK_TOKEN=
GOOGLE_CALENDAR_WEBHOOK_CALLBACK_URL=
GOOGLE_CALENDAR_WATCH_TTL_SECONDS=86400

# ============ OUTBOX SCHEDULER ============
OUTBOX_PROCESS_LIMIT=200
OUTBOX_SCHEDULER_INTERVAL_SECONDS=15

# ============ USER SEED (LOCAL/DEV) ============
# Solo para ejecución manual de create_seed_users.py
# Nunca en producción sin cambiar estos valores
SEED_ADMIN_PASSWORD=
SEED_DOCTOR_PASSWORD=
# Definir solo cuando vayas a ejecutar scripts/seed_users.py
SEED_ADMIN_USERNAME=admin
SEED_DOCTOR_USERNAME=doctor

# ============ MB-CHAT LEARNING PERSISTENCE ============
MEDICAL_CHAT_LEARNING_PATH=/app/artifacts/mb-chat-learning/medical-chat-learning.jsonl
