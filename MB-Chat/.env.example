# Required
GROQ_API_KEY=replace_me
# Dedicated key for the medical chat endpoint (MB-Chat only — do NOT share with other services)
GROQ_API_KEY_CHAT=replace_me
REDIS_URL=redis://redis:6379/0
NLG_GROQ_ENABLED=true
NLG_GROQ_MODEL=llama-3.1-8b-instant
NLG_GROQ_TEMPERATURE=0.2

# Optional
GATEWAY_PORT=8080
LOG_LEVEL=INFO
WORKER_HEARTBEAT_TTL_SECONDS=30
WORKER_RESULT_TTL_SECONDS=3600
MEDICAL_CHAT_TIMEZONE=America/Argentina/Buenos_Aires
MEDICAL_CHAT_WEATHER_ENABLED=true
MEDICAL_CHAT_WEATHER_LAT=-34.6037
MEDICAL_CHAT_WEATHER_LON=-58.3816
MEDICAL_CHAT_WEATHER_LOCATION=Buenos Aires, Argentina
# Optional override. Format: AR=https://feed1,https://feed2;DEFAULT=https://feed3
CLINICAL_GUIDELINE_FEEDS=
MEDICAL_CHAT_LEARNING_PATH=data/medical-chat-learning.jsonl
MEDICAL_CHAT_INTERNET_MODE=open
MEDICAL_CHAT_GOOGLE_CALENDAR_WEBHOOK_URL=
GROQ_SAFE_FOR_PHI=false
