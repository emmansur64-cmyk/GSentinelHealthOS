# === PYTHON ===

# Virtual Environments
.venv/
venv/
env/
ENV/
Lib/                          # Windows venv
Include/
Scripts/                      # Windows venv scripts
bin/                          # Linux/Mac venv
.Python
python.exe
pip

# Python Cache
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg
pip-log.txt
pip-delete-this-directory.txt

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage/
.tox/
.hypothesis/
*.cover
.mypy_cache/
.ruff_cache/

# IDEs & Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.DS_Store

# ============================================================================

# === NODEJS / FRONTEND ===

# Dependencies
node_modules/
package-lock.json

# Build outputs (keep one per frontend build)
frontend/dist/
frontend/build/

# Vite cache
.vite/
vite-cache/

# Environment
.env
.env*
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

