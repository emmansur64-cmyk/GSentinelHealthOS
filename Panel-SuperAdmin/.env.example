# ============================================================
# Panel-SuperAdmin — Environment Variables
# Copy to .env.local and fill in real values
# NEVER commit .env.local
# ============================================================

# ── JWT ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SUPER_ADMIN_JWT_SECRET=change-me-generate-64-random-bytes

# ── Bootstrap Credentials ────────────────────────────────────
# Initial super admin account (before DB integration)
# Generate hash with: node -e "const b=require('bcryptjs'); b.hash('yourpassword',12).then(console.log)"
SUPER_ADMIN_EMAIL=admin@gssentinelhealth.com
SUPER_ADMIN_PASSWORD_HASH=$2a$12$CHANGE_ME_REAL_BCRYPT_HASH
# Transitional fallback (NOT recommended). Keep false by default.
SUPER_ADMIN_ALLOW_PLAIN_PASSWORD_FALLBACK=false

# ── Login Hardening ───────────────────────────────────────────
SUPER_ADMIN_LOGIN_RATE_LIMIT_WINDOW_MS=600000
SUPER_ADMIN_LOGIN_MAX_ATTEMPTS=5
SUPER_ADMIN_LOGIN_LOCKOUT_MS=900000

# ── Backend Auth (server-side only — NEVER expose to browser) ────────────────
# Same value as PANEL_ADMIN_API_KEY configured in the FastAPI api service
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_INTERNAL_KEY=change-me-must-match-api-PANEL_ADMIN_API_KEY

# ── Internal Service URLs ─────────────────────────────────────
# Override in production; defaults target docker-compose service names
MBCHAT_INTERNAL_URL=http://mb-chat:3001
MBSECRETARIA_INTERNAL_URL=http://mb-secretaria:3002
MBWHATSAPP_INTERNAL_URL=http://mb-whatsapp:3003
BRAIN_INTERNAL_URL=http://brain:8001
AGENDA_API_INTERNAL_URL=http://api:8000
MEDICAL_AGENDA_CREATE_CLINIC_URL=http://127.0.0.1:3000/api/internal/client-onboarding

# ── Health Check ──────────────────────────────────────────────
# Timeout in ms for each service health probe
HEALTH_CHECK_TIMEOUT_MS=5000

# ── Groq (read-only status checks) ───────────────────────────
# TODO: persist per-tenant Groq config to DB when tenant module is live
GROQ_API_KEY=gsk_change_me
GROQ_MODEL=llama-3.3-70b-versatile

# ── App ───────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_VERSION=0.1.0
