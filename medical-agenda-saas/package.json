{
  "name": "medical-agenda-saas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "20.x",
    "npm": "10.8.x"
  },
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-singleton.ps1",
    "dev:raw": "next dev",
    "dev:stop": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-stop.ps1",
    "dev:restart": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-singleton.ps1 -ForceRestart",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:seed": "prisma db seed",
    "bootstrap:one-shot": "powershell -ExecutionPolicy Bypass -File ./scripts/bootstrap-one-shot.ps1",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "playwright:install": "playwright install chromium",
    "test:e2e": "npm run prisma:generate && npm run prisma:deploy && npm run prisma:seed && playwright test tests/e2e/login.spec.ts tests/e2e/doctor.spec.ts tests/e2e/resilience.spec.ts",
    "test:e2e:headed": "npm run prisma:generate && npm run prisma:deploy && npm run prisma:seed && playwright test tests/e2e/login.spec.ts tests/e2e/doctor.spec.ts tests/e2e/resilience.spec.ts --headed",
    "test:e2e:resilience": "npm run prisma:generate && npm run prisma:deploy && npm run prisma:seed && playwright test tests/e2e/resilience.spec.ts",
    "whatsapp:worker": "tsx scripts/start-whatsapp-worker.ts",
    "whatsapp:scaled-worker": "tsx -r tsconfig-paths/register scripts/start-whatsapp-scaled-workers.ts",
    "test:whatsapp": "vitest run tests/whatsapp/",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest watch --config vitest.integration.config.ts",
    "test:brain": "vitest run --config vitest.integration.config.ts tests/integration/brain-flow.test.ts",
    "test:workers": "vitest run --config vitest.integration.config.ts tests/integration/worker-pipeline.test.ts",
    "test:stress": "vitest run --config vitest.stress.config.ts",
    "test:stress:full": "RUN_STRESS_INTEGRATION=true RUN_CRITICAL_CONCURRENCY=true vitest run --config vitest.stress.config.ts",
    "stress:run": "tsx tests/stress/stress-runner.ts",
    "stress:full": "tsx tests/stress/stress-runner.ts --full",
    "test:all": "vitest run",
    "imaging:preprocess": "python scripts/preprocess_images.py --input data/raw --output data/processed --size 224 --channels 3",
    "imaging:train": "python train_dl.py --data data/processed --epochs 10 --batch-size 16 --model-out models/medical_model.pt --metrics-out models/medical_metrics.json",
    "imaging:export-onnx": "python export_onnx.py --weights models/medical_model.pt --onnx models/medical_model_v1.onnx --channels 3 --size 224",
    "imaging:generate-model-config": "tsx scripts/imaging-generate-model-config.ts --modelsDir models --out models/model_config.generated.json",
    "job:recalculate-metrics": "tsx jobs/recalculateMetrics.ts",
    "job:recalculate-metrics:watch": "tsx jobs/recalculateMetrics.ts --watch",
    "job:appointment-lifecycle": "tsx jobs/appointmentLifecycle.ts",
    "job:appointment-lifecycle:watch": "tsx jobs/appointmentLifecycle.ts --watch"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/sdk-trace-base": "^2.6.1",
    "@opentelemetry/sdk-trace-node": "^2.6.1",
    "@prisma/client": "^6.18.0",
    "@tanstack/react-query": "^5.90.5",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.73.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dicom-parser": "^1.8.21",
    "ioredis": "^5.10.1",
    "jose": "^6.2.2",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "next-themes": "^0.4.6",
    "onnxruntime-node": "^1.22.0",
    "parquetjs-lite": "^0.8.7",
    "pdfjs-dist": "^5.4.149",
    "prisma": "^6.18.0",
    "prom-client": "^15.1.3",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "react-router-dom": "^7.9.4",
    "redis": "^5.11.0",
    "sharp": "^0.34.4",
    "shadcn": "^4.1.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tesseract.js": "^6.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
}
