APP_ENV=local
APP_NAME=Cerebro AI Med
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
CEREBRO_API_VERSION=1.2.0

# Seguridad API
CEREBRO_API_KEY=change_this_to_a_strong_random_secret
CEREBRO_CORS_ALLOW_ORIGINS=http://127.0.0.1:3000
CEREBRO_CORS_ALLOW_CREDENTIALS=false

# Limites y estabilidad
CEREBRO_REQUEST_TIMEOUT_SECONDS=15
CEREBRO_MAX_REQUEST_BODY_BYTES=10485760
CEREBRO_MAX_TEXT_CHARS=12000
CEREBRO_MAX_IMAGE_BYTES=10485760

# Rate limiting distribuido (Redis)
CEREBRO_RATE_LIMIT_ENABLED=true
CEREBRO_REDIS_URL=redis://127.0.0.1:6379/0
CEREBRO_RATE_LIMIT_REQUESTS=120
CEREBRO_RATE_LIMIT_WINDOW_SECONDS=60
CEREBRO_RATE_LIMIT_FAIL_OPEN=false
