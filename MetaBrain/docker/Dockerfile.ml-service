# ML Service - Microservicio Independiente
# Dockerfile para deployment del servicio ML

FROM node:18-alpine

# Instalar dependencias del sistema para ONNX
RUN apk add --no-cache \
    python3 \
    py3-pip \
    build-base \
    && rm -rf /var/cache/apk/*

# Crear directorio de la aplicación
WORKDIR /app

# Copiar archivos de configuración
COPY package*.json ./
COPY tsconfig*.json ./

# Instalar dependencias
RUN npm ci --only=production

# Copiar código fuente
COPY src/ ./src/
COPY data/ ./data/

# Compilar TypeScript
RUN npm run build

# Crear usuario no-root
RUN addgroup -g 1001 -S nodejs
RUN adduser -S nestjs -u 1001

# Cambiar permisos
RUN chown -R nestjs:nodejs /app
USER nestjs

# Puerto del servicio
EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:3001/ml/health || exit 1

# Comando de inicio
CMD ["node", "dist/main"]