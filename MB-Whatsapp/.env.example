# ── Auth (requerido) ─────────────────────────────────────────────────────────
METABRAIN_API_KEYS=replace_me           # claves válidas separadas por coma (rotación)
METABRAIN_API_KEY=replace_me            # fallback single-key (si METABRAIN_API_KEYS no se usa)
WHATSAPP_APP_SECRET=replace_me
WHATSAPP_VERIFY_TOKEN=replace_me

# ── Groq (requerido) ─────────────────────────────────────────────────────────
GROQ_API_KEY_WHATSAPP=replace_me        # clave activa del canal WhatsApp
GROQ_MODEL_PRIMARY=llama-3.3-70b-versatile
GROQ_MODEL_SECONDARY=llama-3.1-8b-instant

# ── Python NLG pipeline (deshabilitado por defecto) ──────────────────────────
NLG_GROQ_ENABLED=false                  # cambiar a true solo si el pipeline Python está activo
NLG_GROQ_MODEL=llama-3.1-8b-instant
NLG_GROQ_TEMPERATURE=0.2

# ── Medical Imaging (opcional — PHI boundary: patient_age no se envía) ───────
MEDICAL_IMAGING_API_URL=                # URL del endpoint de análisis de imagen (dejar vacío para modo local)
MEDICAL_IMAGING_API_KEY=               # API key del proveedor de imagen
MEDICAL_IMAGING_PROVIDER=specialized-api

# ── Infraestructura ──────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
GATEWAY_PORT=8080
LOG_LEVEL=INFO
WORKER_HEARTBEAT_TTL_SECONDS=30
WORKER_RESULT_TTL_SECONDS=3600
